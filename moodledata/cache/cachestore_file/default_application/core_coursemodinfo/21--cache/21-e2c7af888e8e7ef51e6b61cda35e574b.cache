=yes'); return false;";s:10:"customdata";a:3:{s:10:"filtericon";b:1;s:14:"displayoptions";s:194:"a:4:{s:10:"popupwidth";i:620;s:11:"popupheight";i:450;s:8:"showtype";i:1;s:11:"filedetails";a:3:{s:4:"type";s:12:"PDF document";s:8:"mimetype";s:15:"application/pdf";s:9:"extension";s:3:"PDF";}}";s:7:"display";s:1:"6";}}i:2445;O:8:"stdClass":19:{s:2:"id";s:3:"614";s:2:"cm";s:4:"2445";s:3:"mod";s:5:"label";s:7:"section";s:1:"4";s:13:"sectionnumber";s:1:"4";s:9:"sectionid";s:3:"111";s:6:"module";s:2:"13";s:5:"added";s:10:"1726352122";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:65:"15. インストラクターとのセッション2に参加する";s:7:"content";s:150:"<div class="no-overflow"><h6>15. インストラクターとのセッション2に参加する</h6>
<p>Attend Session 2 with your instructor</p></div>";}i:2446;O:8:"stdClass":19:{s:2:"id";s:3:"615";s:2:"cm";s:4:"2446";s:3:"mod";s:5:"label";s:7:"section";s:1:"4";s:13:"sectionnumber";s:1:"4";s:9:"sectionid";s:3:"111";s:6:"module";s:2:"13";s:5:"added";s:10:"1726352794";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:74:"16. セッション2のメールをインストラクターに送信する";s:7:"content";s:769:"<div class="no-overflow"><h6>16. セッション2のメールをインストラクターに送信する</h6>
<p data-start="23" data-end="78" class=""></p>
<p data-start="23" data-end="78" class="">課題について話す時間をスケジュールしたいと考えています。インストラクターに折り返しの電話をお願いする留守番電話メッセージのような形式でメールを書いてください。</p>
<p dir="ltr" role="presentation">You need to schedule some time to talk about an assignment with your instructor. Write an email as if you are leaving a voicemail asking them to return your call.</p>
<p data-pm-slice="1 1 []"><a href="https://www.at-school-portal.com/moodle/local/mail/view.php?t=inbox">Go to Email</a></p></div>";}i:2447;O:8:"stdClass":17:{s:2:"id";s:3:"167";s:2:"cm";s:4:"2447";s:3:"mod";s:4:"quiz";s:7:"section";s:1:"4";s:13:"sectionnumber";s:1:"4";s:9:"sectionid";s:3:"111";s:6:"module";s:2:"17";s:5:"added";s:10:"1746149687";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"0";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:43:"17. Week 4 Session 2 Quiz - 月曜日まで";}i:2448;O:8:"stdClass":18:{s:2:"id";s:3:"844";s:2:"cm";s:4:"2448";s:3:"mod";s:3:"url";s:7:"section";s:1:"4";s:13:"sectionnumber";s:1:"4";s:9:"sectionid";s:3:"111";s:6:"module";s:2:"21";s:5:"added";s:10:"1743622525";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:45:"18. 第4週 チェックインアンケート";s:7:"onclick";s:240:"window.open('https://www.at-school-portal.com/moodle/mod/url/view.php?id=2448&amp;redirect=1', '', 'width=620,height=450,toolbar=no,location=no,menubar=no,copyhistory=no,status=no,directories=no,scrollbars=yes,resizable=yes'); return false;";s:10:"customdata";a:2:{s:7:"display";s:1:"6";s:10:"filtericon";b:1;}}i:2449;O:8:"stdClass":17:{s:2:"id";s:3:"616";s:2:"cm";s:4:"2449";s:3:"mod";s:5:"label";s:7:"section";s:1:"4";s:13:"sectionnumber";s:1:"4";s:9:"sectionid";s:3:"111";s:6:"module";s:2:"13";s:5:"added";s:10:"1726349071";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:38:"任意の課題 - Optional Assignments";s:7:"content";s:546:"<div class="no-overflow"><h4 data-pm-slice="1 1 []">任意の課題 - Optional Assignments</h4>
