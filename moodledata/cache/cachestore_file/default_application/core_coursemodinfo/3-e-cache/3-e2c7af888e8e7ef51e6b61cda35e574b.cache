<p>Attend Session 2 with your instructor</p></div>";}i:280;O:8:"stdClass":19:{s:2:"id";s:2:"62";s:2:"cm";s:3:"280";s:3:"mod";s:5:"label";s:7:"section";s:1:"3";s:13:"sectionnumber";s:1:"3";s:9:"sectionid";s:2:"17";s:6:"module";s:2:"13";s:5:"added";s:10:"1726352794";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:74:"16. セッション2のメールをインストラクターに送信する";s:7:"content";s:1817:"<div class="no-overflow"><h6>16. セッション2のメールをインストラクターに送信する</h6>
<p data-start="23" data-end="78" class="">講師にメールを書きましょう。以下の内容を含めて、あなたの平日の生活について書いてください：</p>
<ul data-start="80" data-end="189">
<li class="" data-start="80" data-end="93">
<p data-start="82" data-end="93" class="">普段の平日について</p>
</li>
<li class="" data-start="94" data-end="118">
<p data-start="96" data-end="118" class="">何時に起きるか、食事をするか、寝るかなど</p>
</li>
<li class="" data-start="119" data-end="143">
<p data-start="121" data-end="143" class="">今していること（例：勉強中、仕事中など）</p>
</li>
<li class="" data-start="144" data-end="168">
<p data-start="146" data-end="168" class="">一緒に住んでいる人と、その人がどんな人か</p>
</li>
<li class="" data-start="169" data-end="189">
<p data-start="171" data-end="189" class="">その他、あなたの日常について など…</p>
</li>
</ul>
<p><a href="https://www.at-school-portal.com/moodle/local/mail/view.php?t=inbox">メールを開く</a></p>
<p>木曜日まで推奨、月曜日まで必須</p>
<p dir="ltr" role="presentation">Write an email to your instructor and write about:</p>
<ul>
<li dir="ltr" role="presentation">your typical weekday</li>
<li dir="ltr" role="presentation">what time you do things (wake up, eat, go to bed)</li>
<li dir="ltr" role="presentation">what you're doing now</li>
<li dir="ltr" role="presentation">who you live with</li>
<li dir="ltr" role="presentation">what they are like, and so on.</li>
</ul>
<p data-pm-slice="1 1 []"><a href="https://www.at-school-portal.com/moodle/local/mail/view.php?t=inbox">Go to Email</a></p></div>";}i:281;O:8:"stdClass":17:{s:2:"id";s:2:"25";s:2:"cm";s:3:"281";s:3:"mod";s:4:"quiz";s:7:"section";s:1:"3";s:13:"sectionnumber";s:1:"3";s:9:"sectionid";s:2:"17";s:6:"module";s:2:"17";s:5:"added";s:10:"1744666044";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"0";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:43:"17. Week 3 Session 2 Quiz - 月曜日まで";}i:282;O:8:"stdClass":18:{s:2:"id";s:2:"85";s:2:"cm";s:3:"282";s:3:"mod";s:3:"url";s:7:"section";s:1:"3";s:13:"sectionnumber";s:1:"3";s:9:"sectionid";s:2:"17";s:6:"module";s:2:"21";s:5:"added";s:10:"1743622525";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:45:"18. 第3週 チェックインアンケート";s:7:"onclick";s:239:"window.open('https://www.at-school-portal.com/moodle/mod/url/view.php?id=282&amp;redirect=1', '', 'width=620,height=450,toolbar=no,location=no,menubar=no,copyhistory=no,status=no,directories=no,scrollbars=yes,resizable=yes'); return false;";s:10:"customdata";a:2:{s:7:"display";s:1:"6";s:10:"filtericon";b:1;}}i:283;O:8:"stdClass":17:{s:2:"id";s:2:"63";s:2:"cm";s:3:"283";s:3:"mod";s:5:"label";s:7:"section";s:1:"3";s:13:"sectionnumber";s:1:"3";s:9:"sectionid";s:2:"17";s:6:"module";s:2:"13";s:5:"added";s:10:"1726349071";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:38:"任意の課題 - Optional Assignments";s:7:"content";s:546:"<div class="no-overflow"><h4 data-pm-slice="1 1 []">任意の課題 - Optional Assignments</h4>
<p data-pm-slice="1 1 []">以下の練習は推奨されますが、必須の課題ではありません。任意の練習問題を完了した場合は、フィードバックをもらうためにインストラクターに知らせてください。</p>
<p data-pm-slice="1 1 []">The following exercises are encouraged, but are not a required part of the coursework. If you complete optional exercises inform your instructor for feedback.</p></div>";}i:284;O:8:"stdClass":18:{s:2:"id";s:2:"86";s:2:"cm";s:3:"284";s:3:"mod";s:3:"url";s:7:"section";s:1:"3";s:13:"sectionnumber";s:1:"3";s:9:"sectionid";s:2:"17";s:6:"module";s:2:"21";s:5:"added";s:10:"1726632285";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:28:"a.動画課題  - Video work";s:10:"customdata";a:2:{s:7:"display";i:4;s:10:"filtericon";b:1;}}i:285;O:8:"stdClass":18:{s:2:"id";s:2:"87";s:2:"cm";s:3:"285";s:3:"mod";s:3:"url";s:7:"section";s:1:"3";s:13:"sectionnumber";s:1:"3";s:9:"sectionid";s:2:"17";s:6:"module";s:2:"21";s:5:"added";s:10:"1746133596";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"0";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:77:"b. Flashcards - Daily Activities（現在進行形：今していること）";s:10:"customdata";a:2:{s:7:"display";s:1:"1";s:10:"filtericon";b:1;}}i:286;O:8:"stdClass":18:{s:2:"id";s:2:"88";s:2:"cm";s:3:"286";s:3:"mod";s:3:"url";s:7:"section";s:1:"3";s:13:"sectionnumber";s:1:"3";s:9:"sectionid";s:2:"17";s:6:"module";s:2:"21";s:5:"added";s:10:"1746133663";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"0";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:94:"c. Flashcards - Comparative Adjectives – Comparing People, Places, and Things（比較級）";s:10:"customdata";a:2:{s:7:"display";s:1:"1";s:10:"filtericon";b:1;}}i:287;O:8:"stdClass":17:{s:2:"id";s:2:"41";s:2:"cm";s:3:"287";s:3:"mod";s:4:"page";s:7:"section";s:1:"3";s:13:"sectionnumber";s:1:"3";s:9:"sectionid";s:2:"17";s:6:"module";s:2:"16";s:5:"added";s:10:"1738550029";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:28:"d. Week 3 Conversation Study";}i:288;O:8:"stdClass":19:{s:2:"id";s:2:"64";s:2:"cm";s:3:"288";s:3:"mod";s:5:"label";s:7:"section";s:1:"3";s:13:"sectionnumber";s:1:"3";s:9:"sectionid";s:2:"17";s:6:"module";s:2:"13";s:5:"added";s:10:"1726709644";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:27:"e. イマージョン活動";s:7:"content";s:6679:"<div class="no-overflow"><p><strong>e. イマージョン活動</strong></p>
<p><strong>前の週の活動、または以下の中から1つ選んでください：</strong></p>
<hr class="" data-start="371" data-end="374">
<p>📝 <strong data-start="384" data-end="416">1. “Now” Diary – 今の行動を英語で書こう</strong></p>
<p data-start="417" data-end="448" class="">毎日、自分が<strong data-start="423" data-end="434">今していること</strong>を1～2文で記録しましょう。</p>
<p data-start="450" data-end="460" class="">🖋 <strong data-start="453" data-end="460">例文:</strong></p>
<ul data-start="461" data-end="575">
<li class="" data-start="461" data-end="519">
<p data-start="463" data-end="519" class="">"I’m eating lunch with my coworker."<br data-start="499" data-end="502">（同僚と昼ごはんを食べています。）</p>
</li>
<li class="" data-start="520" data-end="575">
<p data-start="522" data-end="575" class="">"I’m watching TV and relaxing."<br data-start="553" data-end="556">（テレビを見てリラックスしています。）</p>
</li>
</ul>
<p data-start="577" data-end="666" class="">💡 <strong data-start="580" data-end="590">チャレンジ:</strong><br data-start="590" data-end="593">家族や友達がしていることも書いてみましょう！<br data-start="615" data-end="618">"He is studying at the library."（彼は図書館で勉強しています。）</p>
<hr class="" data-start="668" data-end="671">
<p>🧍‍♀️🏙 <strong data-start="686" data-end="728">2. Compare and Describe – 比べて＆説明してみよう！</strong></p>
<p data-start="729" data-end="758" class="">1日1つ、<strong data-start="734" data-end="744">人・場所・物</strong>を選んで比較してみましょう。</p>
<p data-start="760" data-end="770" class="">🖋 <strong data-start="763" data-end="770">例文:</strong></p>
<ul data-start="771" data-end="940">
<li class="" data-start="771" data-end="821">
<p data-start="773" data-end="821" class="">"My city is smaller than Tokyo."（私の街は東京より小さいです。）</p>
</li>
<li class="" data-start="822" data-end="886">
<p data-start="824" data-end="886" class="">"This curry is more delicious than last time!"（このカレーは前より美味しい！）</p>
</li>
<li class="" data-start="887" data-end="940">
<p data-start="889" data-end="940" class="">"My father is taller than my mother."（父は母より背が高いです。）</p>
</li>
</ul>
<p data-start="942" data-end="979" class="">💡 <strong data-start="945" data-end="954">ポイント:</strong> "than" を使って、違いを自然に伝える練習！</p>
<hr class="" data-start="981" data-end="984">
<p>🗺 <strong data-start="994" data-end="1037">3. Direction Challenge – 地図を使って案内してみよう！</strong></p>
<p data-start="1038" data-end="1075" class="">Google Maps や手書き地図を使って、<strong data-start="1061" data-end="1071">道案内の英語</strong>を練習！</p>
<p data-start="1077" data-end="1089" class="">🎯 <strong data-start="1080" data-end="1089">タスク例:</strong></p>
<ul data-start="1090" data-end="1129">
<li class="" data-start="1090" data-end="1110">
<p data-start="1092" data-end="1110" class="">あなたの家から駅までの道を説明する。</p>
</li>
<li class="" data-start="1111" data-end="1129">
<p data-start="1113" data-end="1129" class="">コンビニの場所を友達に説明する。</p>
</li>
</ul>
<p data-start="1131" data-end="1141" class="">🖋 <strong data-start="1134" data-end="1141">例文:</strong></p>
<ul data-start="1142" data-end="1266">
<li class="" data-start="1142" data-end="1266">
<p data-start="1144" data-end="1266" class="">"Go straight, then turn right at the corner. The station is next to the supermarket."<br data-start="1229" data-end="1232">（まっすぐ行って、角を右に曲がってください。駅はスーパーの隣です。）</p>
</li>
</ul>
<p data-start="1268" data-end="1303" class="">💡 <strong data-start="1271" data-end="1281">チャレンジ:</strong> チャットボットや友達とロールプレイで練習！</p>
<hr class="" data-start="1305" data-end="1308">
<p>📸 <strong data-start="1318" data-end="1359">4. Photo Comment Practice – 写真で即コメント！</strong></p>
<p data-start="1360" data-end="1391" class="">スマホで1日1枚写真を撮り、<strong data-start="1374" data-end="1391">英語で説明してみましょう。</strong></p>
<p data-start="1393" data-end="1403" class="">📷 <strong data-start="1396" data-end="1403">例文:</strong></p>
<ul data-start="1404" data-end="1547">
<li class="" data-start="1404" data-end="1484">
<p data-start="1406" data-end="1484" class="">"This is my lunch. I’m eating pasta at a café."<br data-start="1453" data-end="1456">（これは私のランチです。カフェでパスタを食べています。）</p>
</li>
<li class="" data-start="1485" data-end="1547">
<p data-start="1487" data-end="1547" class="">"My dog is sleeping under the table."<br data-start="1524" data-end="1527">（うちの犬がテーブルの下で寝ています。）</p>
</li>
</ul>
<p data-start="1549" data-end="1578" class="">💡 写真は SNS に投稿して、英語でコメントしても◎！</p>
<hr class="" data-start="1580" data-end="1583">
<p>🎧 <strong data-start="1593" data-end="1640">5. Listening &amp; Speaking Moments – 英語の瞬間をつくる</strong></p>
<p data-start="1641" data-end="1663" class="">短い時間でも英語に触れる時間を作りましょう！</p>
<p data-start="1665" data-end="1674" class="">👂 <strong data-start="1668" data-end="1674">例:</strong></p>
<ul data-start="1675" data-end="1770">
<li class="" data-start="1675" data-end="1697">
<p data-start="1677" data-end="1697" class="">通勤中に英語のYouTubeを5分見る。</p>
</li>
<li class="" data-start="1698" data-end="1736">
<p data-start="1700" data-end="1736" class="">家事をしながら “What are you doing?” の自問自答。</p>
</li>
<li class="" data-start="1737" data-end="1770">
<p data-start="1739" data-end="1770" class="">英語の動画を見ながら、「この人は今何してる？」を英語で答える。</p>
</li>
</ul>
<p data-start="1772" data-end="1782" class="">🗣 <strong data-start="1775" data-end="1782">例文:</strong></p>
<ul data-start="1783" data-end="1835">
<li class="" data-start="1783" data-end="1835">
<p data-start="1785" data-end="1835" class="">"She is cooking in the kitchen."（彼女はキッチンで料理しています。）</p>
</li>
</ul></div>";}i:289;O:8:"stdClass":19:{s:2:"id";s:2:"49";s:2:"cm";s:3:"289";s:3:"mod";s:8:"resource";s:7:"section";s:1:"3";s:13:"sectionnumber";s:1:"3";s:9:"sectionid";s:2:"17";s:6:"module";s:2:"18";s:5:"added";s:10:"1727751102";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"icon";s:5:"f/pdf";s:4:"name";s:81:"f. 文法概要・参考ガイド（必要に応じて復習してください）";s:7:"onclick";s:244:"window.open('https://www.at-school-portal.com/moodle/mod/resource/view.php?id=289&amp;redirect=1', '', 'width=620,height=450,toolbar=no,location=no,menubar=no,copyhistory=no,status=no,directories=no,scrollbars=yes,resizable=yes'); return false;";s:10:"customdata";a:3:{s:10:"filtericon";b:1;s:14:"displayoptions";s:194:"a:4:{s:10:"popupwidth";i:620;s:11:"popupheight";i:450;s:8:"showtype";i:1;s:11:"filedetails";a:3:{s:4:"type";s:12:"PDF document";s:8:"mimetype";s:15:"application/pdf";s:9:"extension";s:3:"PDF";}}";s:7:"display";s:1:"6";}}i:290;O:8:"stdClass":16:{s:2:"id";s:2:"12";s:2:"cm";s:3:"290";s:3:"mod";s:5:"forum";s:7:"section";s:1:"4";s:13:"sectionnumber";s:1:"4";s:9:"sectionid";s:2:"18";s:6:"module";s:1:"9";s:5:"added";s:10:"1741795826";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:40:"第4週のフォーラム | Week 4 Forum";s:10:"customdata";a:1:{s:12:"trackingtype";s:1:"1";}}i:291;O:8:"stdClass":18:{s:2:"id";s:2:"89";s:2:"cm";s:3:"291";s:3:"mod";s:3:"url";s:7:"section";s:1:"4";s:13:"sectionnumber";s:1:"4";s:9:"sectionid";s:2:"18";s:6:"module";s:2:"21";s:5:"added";s:10:"1726664509";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:50:"1. Duolingoのレッスンを続けてください";s:7:"onclick";s:239:"window.open('https://w