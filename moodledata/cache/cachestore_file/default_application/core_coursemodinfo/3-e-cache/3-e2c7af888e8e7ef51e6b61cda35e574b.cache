urn false;";s:10:"customdata";a:3:{s:10:"filtericon";b:1;s:14:"displayoptions";s:194:"a:4:{s:10:"popupwidth";i:620;s:11:"popupheight";i:450;s:8:"showtype";i:1;s:11:"filedetails";a:3:{s:4:"type";s:12:"PDF document";s:8:"mimetype";s:15:"application/pdf";s:9:"extension";s:3:"PDF";}}";s:7:"display";s:1:"6";}}i:240;O:8:"stdClass":19:{s:2:"id";s:2:"50";s:2:"cm";s:3:"240";s:3:"mod";s:5:"label";s:7:"section";s:1:"2";s:13:"sectionnumber";s:1:"2";s:9:"sectionid";s:2:"16";s:6:"module";s:2:"13";s:5:"added";s:10:"1726352122";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:64:"8. インストラクターとのセッション1に参加する";s:7:"content";s:147:"<div class="no-overflow"><p>8. インストラクターとのセッション1に参加する</p>
