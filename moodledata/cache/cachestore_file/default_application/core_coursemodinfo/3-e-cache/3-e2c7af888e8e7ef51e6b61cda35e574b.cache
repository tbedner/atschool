es'); return false;";s:10:"customdata";a:3:{s:10:"filtericon";b:1;s:14:"displayoptions";s:194:"a:4:{s:10:"popupwidth";i:620;s:11:"popupheight";i:450;s:8:"showtype";i:1;s:11:"filedetails";a:3:{s:4:"type";s:12:"PDF document";s:8:"mimetype";s:15:"application/pdf";s:9:"extension";s:3:"PDF";}}";s:7:"display";s:1:"6";}}i:217;O:8:"stdClass":19:{s:2:"id";s:2:"45";s:2:"cm";s:3:"217";s:3:"mod";s:5:"label";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"15";s:6:"module";s:2:"13";s:5:"added";s:10:"1726352122";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:65:"15. インストラクターとのセッション2に参加する";s:7:"content";s:150:"<div class="no-overflow"><h6>15. インストラクターとのセッション2に参加する</h6>
<p>Attend Session 2 with your instructor</p></div>";}i:218;O:8:"stdClass":19:{s:2:"id";s:2:"46";s:2:"cm";s:3:"218";s:3:"mod";s:5:"label";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"15";s:6:"module";s:2:"13";s:5:"added";s:10:"1726352794";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:74:"16. セッション2のメールをインストラクターに送信する";s:7:"content";s:3335:"<div class="no-overflow"><h6>16. セッション2のメールをインストラクターに送信する</h6>
<p data-start="50" data-end="69"><strong data-start="50" data-end="69">ご滞在中のご不便に対するお詫び</strong></p>
<p data-start="71" data-end="142">ゲストがご滞在中に問題（例：エアコンが作動しなかった、騒音があったなど）を経験しました。学生は謝罪のメールを送り、補償やサポートを申し出ます。</p>
<p data-start="144" data-end="185"><strong data-start="144" data-end="157">メール返信の課題：</strong><br data-start="157" data-end="160"><strong data-start="160" data-end="185">件名：ご不便をおかけしましたことへのお詫び</strong></p>
<p data-start="187" data-end="195">[ゲスト名] 様</p>
<p data-start="197" data-end="277">このたびは、[ホテル名] にご滞在中、ご不便をおかけしましたことを心よりお詫び申し上げます。[例：エアコン] がご期待に沿えなかったことを、大変遺憾に存じます。</p>
<p data-start="279" data-end="377">当ホテルでは、[例：メンテナンスチームに報告済み] など、問題の解決に迅速に対応しております。また、お詫びの気持ちとして、[例：割引、無料朝食、部屋のアップグレード] をご提供させていただきます。</p>
<p data-start="379" data-end="427">貴重なご意見をいただき誠にありがとうございます。ぜひまたのご利用をご検討いただけますと幸いです。</p>
<p data-start="429" data-end="466">その他にご不明点やご要望がございましたら、どうぞお気軽にお知らせください。</p>
<p data-start="468" data-end="499">敬具<br data-start="470" data-end="473">[学生の名前]<br data-start="480" data-end="483">ゲストサービス – [ホテル名]</p>
<p><a href="https://www.at-school-portal.com/moodle/local/mail/view.php?t=inbox">メールを開く</a></p>
<p>木曜日まで推奨、月曜日まで必須</p>
<p><strong>Apology for Inconvenience During Stay</strong></p>
<p>A guest experienced a problem during their stay (e.g., air conditioning wasn’t working, or there was a noise issue). Send an apology email and offers compensation or assistance.</p>
<p><em>Email Response Prompt:</em></p>
<p>Subject: Our Apologies for the Inconvenience</p>
<p>Dear [Guest Name],</p>
<p>I would like to sincerely apologize for the inconvenience you experienced during your stay at [Hotel Name]. We regret that the [issue – e.g., air conditioner] did not meet your expectations.</p>
<p>We have [resolution - reported the issue to our maintenance team], and we are working to resolve it promptly. As a gesture of apology, we would like to offer [e.g., a discount, complimentary breakfast, or room upgrade].</p>
<p>We truly value your feedback and hope you will consider staying with us again. Please let us know if there is anything else we can do to assist you.</p>
<p>Warm regards,</p>
<p> [Student’s Name]<br> Guest Services – [Hotel Name]</p>
<p data-pm-slice="1 1 []"><a href="https://www.at-school-portal.com/moodle/local/mail/view.php?t=inbox">Go to Email</a></p>
<p data-pm-slice="1 1 []">Recommended by Thursday, required by Monday</p></div>";}i:319;O:8:"stdClass":16:{s:2:"id";s:2:"29";s:2:"cm";s:3:"319";s:3:"mod";s:4:"quiz";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"15";s:6:"module";s:2:"17";s:5:"added";s:10:"1751329523";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:43:"17. Week 1 Session 2 Quiz - 月曜日まで";}i:220;O:8:"stdClass":18:{s:2:"id";s:2:"63";s:2:"cm";s:3:"220";s:3:"mod";s:3:"url";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"15";s:6:"module";s:2:"21";s:5:"added";s:10:"1743622638";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:45:"18. 第1週 チェックインアンケート";s:7:"onclick";s:239:"window.open('https://www.at-school-portal.com/moodle/mod/url/view.php?id=220&amp;redirect=1', '', 'width=620,height=450,toolbar=no,location=no,menubar=no,copyhistory=no,status=no,directories=no,scrollbars=yes,resizable=yes'); return false;";s:10:"customdata";a:2:{s:7:"display";s:1:"6";s:10:"filtericon";b:1;}}i:221;O:8:"stdClass":17:{s:2:"id";s:1:"6";s:2:"cm";s:3:"221";s:3:"mod";s:13:"questionnaire";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"15";s:6:"module";s:2:"27";s:5:"added";s:10:"1740953352";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"0";s:10:"completion";s:1:"2";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:10:"customdata";O:8:"stdClass":1:{s:21:"customcompletionrules";a:1:{s:16:"completionsubmit";s:1:"1";}}s:4:"name";s:64:"19. フォーカスグループフィードバックフォーム";}i:222;O:8:"stdClass":17:{s:2:"id";s:2:"47";s:2:"cm";s:3:"222";s:3:"mod";s:5:"label";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"15";s:6:"module";s:2:"13";s:5:"added";s:10:"1726349071";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:38:"任意の課題 - Optional Assignments";s:7:"content";s:546:"<div class="no-overflow"><h4 data-pm-slice="1 1 []">任意の課題 - Optional Assignments</h4>
<p data-pm-slice="1 1 []">以下の練習は推奨されますが、必須の課題ではありません。任意の練習問題を完了した場合は、フィードバックをもらうためにインストラクターに知らせてください。</p>
<p data-pm-slice="1 1 []">The following exercises are encouraged, but are not a required part of the coursework. If you complete optional exercises inform your instructor for feedback.</p></div>";}i:223;O:8:"stdClass":18:{s:2:"id";s:2:"64";s:2:"cm";s:3:"223";s:3:"mod";s:3:"url";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"15";s:6:"module";s:2:"21";s:5:"added";s:10:"1726632285";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:31:"a. ビデオ課題 - Video Work";s:10:"customdata";a:2:{s:7:"display";i:4;s:10:"filtericon";b:1;}}i:224;O:8:"stdClass":18:{s:2:"id";s:2:"65";s:2:"cm";s:3:"224";s:3:"mod";s:3:"url";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"15";s:6:"module";s:2:"21";s:5:"added";s:10:"1746132953";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:30:"b. Week 1 Session 1 Flashcards";s:10:"customdata";a:2:{s:7:"display";s:1:"1";s:10:"filtericon";b:1;}}i:225;O:8:"stdClass":18:{s:2:"id";s:2:"66";s:2:"cm";s:3:"225";s:3:"mod";s:3:"url";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"15";s:6:"module";s:2:"21";s:5:"added";s:10:"1746133112";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:30:"c. Week 1 Session 2 Flashcards";s:10:"customdata";a:2:{s:7:"display";s:1:"1";s:10:"filtericon";b:1;}}i:226;O:8:"stdClass":17:{s:2:"id";s:2:"35";s:2:"cm";s:3:"226";s:3:"mod";s:4:"page";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"15";s:6:"module";s:2:"16";s:5:"added";s:10:"1738550029";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:28:"d. Week 1 Conversation Study";}i:227;O:8:"stdClass":19:{s:2:"id";s:2:"48";s:2:"cm";s:3:"227";s:3:"mod";s:5:"label";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"15";s:6:"module";s:2:"13";s:5:"added";s:10:"1726709644";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:27:"e. イマージョン活動";s:7:"content";s:13484:"<div class="no-overflow"><p><strong>e. イマージョン活動</strong></p>
<h2 data-start="127" data-end="157">ホテル英語 イマージョン活動（自宅・自己学習用）</h2>
<h3 data-start="159" data-end="187">1. 🎧 英語リスニング練習 – ホテルの場面</h3>
<p data-start="189" data-end="293"><strong data-start="189" data-end="196">内容：</strong><br data-start="196" data-end="199">YouTube や Netflix などで、ホテルを舞台にした短い動画やテレビシーンを視聴します。チェックイン、ゲストのクレーム、スモールトーク、コンシェルジュの対応などに注目しましょう。</p>
<p data-start="295" data-end="373"><strong data-start="295" data-end="302">目的：</strong><br data-start="302" data-end="305">丁寧な表現、声のトーン、ボディランゲージを観察します。<br data-start="332" data-end="335">💡ヒント：聞こえた新しい表現を3つ書き出し、声に出して練習してみましょう。</p>
<p data-start="375" data-end="390">以下はYouTubeの例です：</p>
<ul data-start="392" data-end="637">
<li data-start="392" data-end="445">
<p data-start="394" data-end="445"><a class="" href="https://www.youtube.com/watch?v=MYX7RVOf3Yc&amp;t=12s" target="_new" rel="noopener" data-start="394" data-end="443">https://www.youtube.com/watch?v=MYX7RVOf3Yc&amp;t=12s</a></p>
</li>
<li data-start="446" data-end="493">
<p data-start="448" data-end="493"><a class="" href="https://www.youtube.com/watch?v=dmaVnB8CfQA" target="_new" rel="noopener" data-start="448" data-end="491">https://www.youtube.com/watch?v=dmaVnB8CfQA</a></p>
</li>
<li data-start="494" data-end="541">
<p data-start="496" data-end="541"><a class="" href="https://www.youtube.com/watch?v=Q8EF22Jqybc" target="_new" rel="noopener" data-start="496" data-end="539">https://www.youtube.com/watch?v=Q8EF22Jqybc</a></p>
</li>
<li data-start="542" data-end="589">
<p data-start="544" data-end="589"><a class="" href="https://www.youtube.com/watch?v=rgVccetJxAw" target="_new" rel="noopener" data-start="544" data-end="587">https://www.youtube.com/watch?v=rgVccetJxAw</a></p>
</li>
<li data-start="590" data-end="637">
<p data-start="592" data-end="637"><a class="" href="https://www.youtube.com/watch?v=RJYoFjX5MiA" target="_new" rel="noopener" data-start="592" data-end="635">https://www.youtube.com/watch?v=RJYoFjX5MiA</a></p>
</li>
</ul>
<hr data-start="639" data-end="642">
<h3 data-start="644" data-end="673">2. 🗣️ 毎日のスモールトーク練習（鏡の前で）</h3>
<p data-start="675" data-end="734"><strong data-start="675" data-end="682">内容：</strong><br data-start="682" data-end="685">朝または夜に鏡の前に立ち、ホテルのゲストに話しかけるつもりで短いスモールトークの会話を練習します。</p>
<p data-start="736" data-end="748"><strong data-start="736" data-end="746">例トピック：</strong></p>
<ul data-start="749" data-end="816">
<li data-start="749" data-end="769">
<p data-start="751" data-end="769">天気：「今日はいい天気ですね？」</p>
</li>
<li data-start="770" data-end="791">
<p data-start="772" data-end="791">旅行：「フライトは快適でしたか？」</p>
</li>
<li data-start="792" data-end="816">
<p data-start="794" data-end="816">予定：「今日はどこか観光される予定ですか？」</p>
</li>
</ul>
<p data-start="818" data-end="855"><strong data-start="818" data-end="825">目的：</strong><br data-start="825" data-end="828">自然なトーンと丁寧な表現を使って、自信をつけましょう。</p>
<hr data-start="857" data-end="860">
<h3 data-start="862" data-end="879">3. 📝 ゲスト応対日記</h3>
<p data-start="881" data-end="976"><strong data-start="881" data-end="888">内容：</strong><br data-start="888" data-end="891">シンプルな英語日記をつけましょう。勤務後または練習後に、ゲストとのやりとりについて英語で2〜3文書いてみましょう。また、「こう言えばよかった」と思う表現も記録しましょう。</p>
<p data-start="978" data-end="1022"><strong data-start="978" data-end="985">目的：</strong><br data-start="985" data-end="988">実際のコミュニケーションを振り返り、次に使えるフレーズを蓄積します。</p>
<hr data-start="1024" data-end="1027">
<h3 data-start="1029" data-end="1075">4. 📱 <strong data-start="1039" data-end="1055">AI Chat Tool</strong> (Bilingual Section)</h3>
<p data-start="1077" data-end="1321"><strong data-start="1077" data-end="1092">What to do:</strong><br data-start="1092" data-end="1095">Use tools like our chat tool to simulate check-in conversations, small talk with a guest or another situation relevant to your specific work.<br data-start="1236" data-end="1239"><strong data-start="1239" data-end="1248">Goal:</strong><br data-start="1248" data-end="1251">Get comfortable using hotel-specific English in real-time interaction.</p>
<p data-start="1323" data-end="1503"><strong data-start="1323" data-end="1503">Here are some example prompts. If you would like help crafting a prompt for your specific situation, please message your instructor or email us at <a class="cursor-pointer" rel="noopener" data-start="1472" data-end="1500">support@at-school-portal.com</a>:</strong></p>
<hr data-start="1505" data-end="1508">
<p data-start="1510" data-end="1704">🔹 <strong data-start="1513" data-end="1546">Check-In Practice | チェックインの練習</strong><br data-start="1546" data-end="1549">Prompt:<br data-start="1556" data-end="1559">"You are a hotel guest checking in for the night. Please speak to me as the hotel front desk staff."<br data-start="1659" data-end="1662">「あなたは今夜チェックインするホテルのゲストです。私はフロント係として対応します。」</p>
<hr data-start="1706" data-end="1709">
<p data-start="1711" data-end="1922">🔹 <strong data-start="1714" data-end="1748">Making Small Talk | スモールトークの練習</strong><br data-start="1748" data-end="1751">Prompt:<br data-start="1758" data-end="1761">"You are a friendly hotel guest. Make some small talk with me about the weather, travel, or sightseeing."<br data-start="1866" data-end="1869">「あなたはフレンドリーなホテルゲストです。天気、旅行、観光などについて私にスモールトークをしてください。」</p>
<hr data-start="1924" data-end="1927">
<p data-start="1929" data-end="2149">🔹 <strong data-start="1932" data-end="1968">Asking About the Area | 周辺情報を尋ねる</strong><br data-start="1968" data-end="1971">Prompt:<br data-start="1978" data-end="1981">"You are a hotel guest who wants to know about nearby restaurants and tourist attractions. Please ask me for information."<br data-start="2103" data-end="2106">「あなたは周辺のレストランや観光スポットを知りたいゲストです。私に質問してください。」</p>
<hr data-start="2151" data-end="2154">
<p data-start="2156" data-end="2357">🔹 <strong data-start="2159" data-end="2190">Guest Complaint | クレーム対応の練習</strong><br data-start="2190" data-end="2193">Prompt:<br data-start="2200" data-end="2203">"You are a hotel guest who has a problem with your room. Please complain politely, and I will try to help."<br data-start="2310" data-end="2313">「あなたは部屋に問題があるゲストです。丁寧にクレームを言ってください。私は対応します。」</p>
<hr data-start="2359" data-end="2362">
<p data-start="2364" data-end="2551">🔹 <strong data-start="2367" data-end="2399">Asking for Help | サポートを求める練習</strong><br data-start="2399" data-end="2402">Prompt:<br data-start="2409" data-end="2412">"You are a hotel guest who needs help with luggage or directions. Please ask me for assistance."<br data-start="2508" data-end="2511">「あなたは荷物や道案内のサポートが必要なゲストです。私に助けを求めてください。」</p>
<hr data-start="2553" data-end="2556">
<p data-start="2558" data-end="2745">🔹 <strong data-start="2561" data-end="2606">Late Check-Out Request | レイトチェックアウトのリクエスト</strong><br data-start="2606" data-end="2609">Prompt:<br data-start="2616" data-end="2619">"You are a hotel guest who wants to request a late check-out. Please ask politely."<br data-start="2702" data-end="2705">「あなたはレイトチェックアウトをお願いしたいゲストです。丁寧に頼んでください。」</p>
<hr data-start="2747" data-end="2750">
<p data-start="2752" data-end="2978">🔹 <strong data-start="2755" data-end="2796">Room Service Inquiry | ルームサービスについて尋ねる</strong><br data-start="2796" data-end="2799">Prompt:<br data-start="2806" data-end="2809">"You are a guest who wants to ask about room service options. Ask me what you can order and when it’s available."<br data-start="2922" data-end="2925">「あなたはルームサービスについて尋ねたいゲストです。何が注文できるか、いつ利用できるかを聞いてください。」</p>
<hr data-start="2980" data-end="2983">
<p data-start="2985" data-end="3209">🔹 <strong data-start="2988" data-end="3022">Lost Item Scenario | 忘れ物・紛失の対応</strong><br data-start="3022" data-end="3025">Prompt:<br data-start="3032" data-end="3035">"You are a guest who lost your phone or left something in the lobby. Please tell me and ask if we found it."<br data-start="3143" data-end="3146">「あなたは携帯電話を失くした、またはロビーに忘れ物をしたゲストです。私にそのことを伝えて、見つかったかどうか聞いてください。」</p>
<hr data-start="3211" data-end="3214">
<h3 data-start="3216" data-end="3243">5. 📄 ウェルカムスピーチを作って練習する</h3>
<p data-start="3245" data-end="3306"><strong data-start="3245" data-end="3252">内容：</strong><br data-start="3252" data-end="3255">30秒の英語でのウェルカムスピーチを考え、練習しましょう。丁寧な表現とスモールトークを入れてください。</p>
<p data-start="3308" data-end="3426"><strong data-start="3308" data-end="3314">例：</strong><br data-start="3314" data-end="3317">「Good evening, welcome to our hotel. We’re happy to have you. Did you find everything okay on your way here?」</p>
<p data-start="3428" data-end="3466"><strong data-start="3428" data-end="3435">目的：</strong><br data-start="3435" data-end="3438">フロントでの対応に自信を持ち、自然に話せるようにします。</p>
<hr data-start="3468" data-end="3471">
<h3 data-start="3473" data-end="3507">6. 🎧 ポッドキャストやオーディオブックのシャドーイング</h3>
<p data-start="3509" data-end="3577"><strong data-start="3509" data-end="3516">内容：</strong><br data-start="3516" data-end="3519">英語のポッドキャスト（ホテル業界、旅行、日常会話など）を聞きながら、話された文を繰り返します（シャドーイング練習）。</p>
<p data-start="3579" data-end="3609"><strong data-start="3579" data-end="3586">目的：</strong><br data-start="3586" data-end="3589">リスニング力、発音、リズム感を養います。</p>
<p data-start="3611" data-end="3627"><strong data-start="3611" data-end="3627">おすすめポッドキャスト：</strong></p>
<p data-start="3629" data-end="3640">🔹 英語学習用：</p>
<ul data-start="3641" data-end="3833">
<li data-start="3641" data-end="3772">
<p data-start="3643" data-end="3772"><a class="" href="https://tunein.com/podcasts/Foreign-Language-Study/Learn-English-Perfect-English-for-Hotel-Hospitality--Tourism-Staff-p3636730/" target="_new" rel="noopener" data-start="3643" data-end="3770">https://tunein.com/podcasts/Foreign-Language-Study/Learn-English-Perfect-English-for-Hotel-Hospitality--Tourism-Staff-p3636730/</a></p>
</li>
<li data-start="3773" data-end="3833">
<p data-start="3775" data-end="3833"><a class="" href="https://improving-your-english.com/learn-english/podcasts/" target="_new" rel="noopener" data-start="3775" data-end="3833">https://improving-your-english.com/learn-english/podcasts/</a></p>
</li>
</ul>
<p data-start="3835" data-end="3852">🔹 ホスピタリティ業界向け：</p>
<ul data-start="3853" data-end="4045">
<li data-start="3853" data-end="3918">
<p data-start="3855" data-end="3918"><a class="" href="https://thehotelgm.com/hotel-management/hospitality-podcasts/" target="_new" rel="noopener" data-start="3855" data-end="3916">https://thehotelgm.com/hotel-management/hospitality-podcasts/</a></p>
</li>
<li data-start="3919" data-end="3987">
<p data-start="3921" data-end="3987"><a class="" href="https://hoteltechreport.com/news/best-hotel-hospitality-podcasts" target="_new" rel="noopener" data-start="3921" data-end="3985">https://hoteltechreport.com/news/best-hotel-hospitality-podcasts</a></p>
</li>
<li data-start="3988" data-end="4045">
<p data-start="3990" data-end="4045"><a class="" href="https://hoteloperations.com/hotel-hospitality-podcasts/" target="_new" rel="noopener" data-start="3990" data-end="4045">https://hoteloperations.com/hotel-hospitality-podcasts/</a></p>
</li>
</ul></div>";}i:228;O:8:"stdClass":19:{s:2:"id";s:2:"38";s:2:"cm";s:3:"228";s:3:"mod";s:8:"resource";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"15";s:6:"module";s:2:"18";s:5:"added";s:10:"1727751102";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:6:"indent";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"icon";s:5:"f/pdf";s:4:"name";s:81:"f. 文法概要・参考ガイド（必要に応じて復習してください）";s:7:"onclick";s:244:"window.open('https://www.at-school-portal.com/moodle/mod/resource/view.php?id=228&amp;redirect=1', '', 'width=620,height=450,toolbar=no,location=no,menubar=no,copyhistory=no,status=no,directories=no,scrollbars=yes,resizable=yes'); return false;";s:10:"customdata";a:3:{s:10:"filtericon";b:1;s:14:"displayoptions";s:194:"a:4:{s:10:"popupwidth";i:620;s:11:"popupheight";i:450;s:8:"showtype";i:1;s:11:"filedetails";a:3:{s:4:"type";s:12:"PDF document";s:8:"mimetype";s:15:"application/pdf";s:9:"extension";s:3:"PDF";}}";s:7:"display";s:1:"6";}}i:229;O:8:"stdClass":17:{s:2:"id";s:2:"39";s:2:"cm";s:3:"229";s:3:"mod";s:8:"resource";s:7:"section";s:1:"2";s:13:"sectionnumber";s:1:"2";s:9:"sectionid";s:2:"16";s:6:"module";s:2:"18";s:5:"added";s:10:"1726579774";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"0";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"icon";s:5:"f/pdf";s:4:"name";s:20:"Teacher Lesson Plans";s:10:"customdata";a:3:{s:10:"filtericon";b:1;s:14:"displayoptions";s:167:"a:3:{s:10:"printintro";i:1;s:8:"showtype";i:1;s:11:"filedetails";a:3:{s:4:"type";s:12:"PDF document";s:8:"mimetype";s:15:"application/pdf";s:9:"extension";s:3:"PDF";}}";s:7:"display";s:1:"1";}}i:230;O:8:"stdClass":16:{s:2:"id";s:2:"10";s:2:"cm";s:3:"230";s:3:"mod";s:5:"forum";s:7:"section";s:1:"2";s:13:"sectionnumber";s:1:"2";s:9:"sectionid";s:2:"16";s:6:"module";s:1:"9";s:5:"added";s:10:"1741795826";s:7:"visible";s:1:"0";s:19:"visibleon