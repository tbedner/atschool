<th><span class="multilang" lang="en">TOEIC Score</span> <span class="multilang" lang="ja">TOEICスコア</span> <span class="multilang" lang="ko">TOEIC 점수</span> <span class="multilang" lang="es">Puntaje TOEIC</span> <span class="multilang" lang="de">TOEIC-Punktzahl</span> <span class="multilang" lang="fr">Score TOEIC</span> <span class="multilang" lang="pt">Pontuação TOEIC</span> <span class="multilang" lang="bg">Резултат на TOEIC</span> <span class="multilang" lang="ru">Баллы TOEIC</span> <span class="multilang" lang="ar">درجة TOEIC</span> <span class="multilang" lang="hi">TOEIC स्कोर</span> <span class="multilang" lang="zh_tw">TOEIC 分數</span> <span class="multilang" lang="zh_cn">TOEIC 分数</span></th>
