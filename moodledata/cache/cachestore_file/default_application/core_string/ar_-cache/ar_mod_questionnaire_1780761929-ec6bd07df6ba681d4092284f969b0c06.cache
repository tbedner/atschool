a:624:{s:25:"accessibility:rate:choice";s:87:"Row {$a->rowposition}, {$a->choicetitle}: Column {$a->colposition}, {$a->choiceanswer}.";s:6:"action";s:14:"الإجراء";s:16:"activityoverview";s:40:"لديك استبيانات مستحقة";s:14:"additionalinfo";s:27:"معلومات إضافية";s:19:"additionalinfo_help";s:206:"النص الذي سيتم عرضه في الجزء العلوي من الصفحة الأولى لهذا الاستبيان. (أي التعليمات، معلومات الخلفية، وما إلى ذلك).";s:14:"addnewquestion";s:24:"إضافة {$a} سؤال";s:13:"addnewsection";s:26:"إضافة قسم جديد";s:11:"addquestion";s:22:"إضافة سؤال...";s:12:"addquestions";s:25:"إضافة الأسئلة";s:20:"addquestiontosection";s:41:"إضافة السؤال إلى القسم";s:11:"addselqtype";s:45:"إضافة سؤال بالنوع المحدد";s:9:"alignment";s:38:"محاذاة أزرار الراديو";s:14:"alignment_help";s:82:"حدد محاذاة الأزرار: عمودي (الافتراضي) أو أفقي.";s:14:"alignment_link";s:41:"mod/questionnaire/questions#Radio_Buttons";s:3:"all";s:8:"الكل";s:15:"allnameddegrees";s:31:"الدرجات المسمّاة";s:20:"allnameddegrees_help";s:140:"حدد نصاً لعرضه لقيم التقييم بدلاً من الرقم. اترك القيمة فارغة لعدم استعمالها.";s:13:"alreadyfilled";s:108:"لقد قمت بالفعل بملء هذا الاستبيان بالنسبة لنا {$a}. شكراً لكم.";s:12:"allresponses";s:13:"All responses";s:16:"andaveragevalues";s:29:"والقيم المتوسطة";s:9:"anonymous";s:10:"مجهول";s:11:"answergiven";s:36:"هذه الإجابة المقدمة";s:14:"answernotgiven";s:31:"هذا الجواب لم يعط";s:6:"answer";s:14:"الإجابة";s:7:"answers";s:14:"الأجوبة";s:15:"answerquestions";s:40:"أجب عن هذا الاستبيان...";s:9:"attempted";s:42:"تم تقديم هذا الاستبيان.";s:15:"attemptsallowed";s:46:"المحاولات المسموح بها: {$a}";s:22:"attemptstillinprogress";s:42:"قيد التفيذ. تم الحفظ في:";s:17:"autodeletereponse";s:31:"Auto delete responses after [?]";s:22:"autodeletereponse_desc";s:149:"Enable this setting to automatically delete old responses based on the time set in “Delete old responses after.” Disable to retain all responses.";s:13:"autonumbering";s:23:"ترقيم تلقائي";s:18:"autonumbering_help";s:183:"الترقيم التلقائي للأسئلة والصفحات. قد