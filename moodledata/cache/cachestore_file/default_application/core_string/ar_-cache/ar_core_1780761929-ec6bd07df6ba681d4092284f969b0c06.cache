ctivities";s:23:"جميع الانشطة";s:13:"allcategories";s:27:"كافة التصنيفات";s:7:"alldays";s:17:"كل الأيام";s:8:"allfiles";s:19:"كل الملفات";s:9:"allgroups";s:23:"كل المجموعات";s:10:"allchanges";s:23:"كل التغييرات";s:7:"alllogs";s:21:"كل الوقوعات";s:7:"allmods";s:9:"كل {$a}";s:5:"allow";s:8:"إسمح";s:13:"allowinternal";s:42:"السماح بالطرق الداخلية";s:19:"allowstealthmodules";s:46:"السماح بالنشاطات المخفية";s:24:"allowstealthmodules_help";s:449:"عند تمكينها، سيكون بالإمكان جعل النشاطات موجودة ولكن غير ظاهرة ضمن مقاطع مرئية في صفحات المقررات. في هذه الحالة، ينبغي وضع روابط للنشاطات المخفية في مكان آخر، مثلاً من مورد الصفحة. النشاطات المخفية ستظل مدرجة في سجل التقديرات وفي التقارير الأخرى.";s:9:"allownone";s:19:"عدم السماح";s:8:"allownot";s:13:"لا تسمح";s:15:"allparticipants";s:23:"كل المشاركين";s:11:"allteachers";s:21:"كل المعلمون";s:14:"alphanumerical";s:76:"لا يقبل إلا حروفا هجائية أو أرقاما أو - أو .";s:16:"alreadyconfirmed";s:43:"تم تأكيد التسجيل بالفعل";s:13:"alternatename";s:23:"الاسم البديل";s:6:"always";s:12:"دائماً";s:3:"and";s:41:"{$a->one} واحد و{$a->two} أثنين";s:6:"answer";s:14:"الإجابة";s:3:"any";s:4:"أي";s:7:"approve";s:19:"موافق عليه";s:10:"appearance";s:12:"المظهر";s:5:"apply";s:10:"تطبيق";s:12:"applyfilters";s:27:"تطبيق المرشحات";s:10:"areyousure";s:24:"هل انت متأكد؟";s:23:"areyousuretorestorethis";s:37:"هل ترغب في المواصله؟";s:27:"areyousuretorestorethisinfo";s:165:"لاحقاً في هذا الإجراء ستخير لإضافة هذه النسخة الاحتياطية إلى مقرر موجود أو إنشاء مقرر جديد";s:3:"asc";s:12:"تصاعدي";s:10:"assessment";s:10:"تقييم";s:12:"assignadmins";s:17:"عين مدراء";s:14:"assigncreators";s:19:"عين منشئون";s:17:"assignedrolecount";s:23:"{$a->role}: {$a->count}";s:15:"assignsiteroles";s:52:"إسناد أدوار على مستوى الموقع";s:17:"authenticateduser";s:40:"المستخدم المصادق عليه";s:28:"authenticateduserdescription";s:60:"كل المستخدمين المتواجدين حالياً.";s:14:"authentication";s:16:"المصادقة";s:21:"authenticationplugins";s:29:"إضافات المصادقة";s:13:"autosubscribe";s:37:"تسجيل آلى في