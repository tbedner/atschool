a:18:{s:18:"adhocsyncscheduled";s:79:"Missing enrolments will be synchronised in the following minutes (during cron).";s:6:"course";s:12:"Go to course";s:12:"invalidlevel";s:50:"The level must be a number equal or higher than 2.";s:13:"levelincourse";s:25:"Course to attain level in";s:13:"levelninvalid";s:14:"{$a} (invalid)";s:13:"leveltoattain";s:15:"Level to attain";s:30:"messageprovider:welcomemessage";s:37:"Level Up XP enrolment welcome message";s:26:"noteaboutexistingenrolment";s:144:"This enrolment method has no effect when the user is already enrolled in the course, even if their enrolment is outdated, suspended or disabled.";s:8:"notethat";s:4:"Note";s:10:"pluginname";s:21:"Level Up XP Enrolment";s:16:"privacy:metadata";s:47:"The plugin does not store any user information.";s:19:"syncpossiblemissing";s:46:"Sync and look for possible missing enrolments.";s:14:"welcomemessage";s:17:"A welcome message";s:19:"welcomemessage_help";s:363:"A message that will be sent to users when they are enrolled in the course. Leave this empty if you do not wish to send a message.

