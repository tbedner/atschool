a:2257:{s:18:"abouttobeinstalled";s:51:"предстои да бъде инсталиран";s:6:"accept";s:16:"Приемане";s:6:"action";s:16:"Действие";s:12:"actionchoice";s:71:"Какво желаете да направите с файла '{$a}'?";s:7:"actions";s:16:"Действия";s:11:"actionsmenu";s:28:"Меню с действия";s:6:"active";s:14:"Активен";s:11:"activeusers";s:37:"Активни потребители";s:10:"activities";s:16:"Дейности";s:15:"activities_help";s:188:"Дейности като форуми, тестове и уикита, позволяват да бъде добавено интерактивно съдържание към курса.";s:8:"activity";s:14:"Дейност";s:17:"activityclipboard";s:57:"Преместване на тази дейност: {$a}";s:12:"activityicon";s:15:"{$a} икона";s:25:"activityiscurrentlyhidden";s:66:"Съжаляваме, но тази дейност е скрита";s:14:"activityheader";s:32:"Меню на дейността";s:14:"activitymodule";s:30:"Модул за дейност";s:15:"activitymodules";s:34:"Модули за дейности";s:16:"activitynotready";s:46:"Дейността още не е готова";s:14:"activityreport";s:34:"Отчет за дейността";s:15:"activityreports";s:36:"Отчети за дейността";s:14:"activityselect";s:108:"Избиране на дейността, за да бъде преместена на друго място";s:13:"activitysince";s:24:"Дейност от {$a}";s:17:"activitytypetitle";s:27:"{$a->activity} - {$a->type}";s:16:"activityweighted";s:42:"Дейности по потребител";s:10:"actionsfor";s:26:"Действия за {$a}";s:3:"add";s:16:"Добавяне";s:11:"addactivity";s:39:"Добавяне на дейност...";s:20:"addactivitytosection";s:63:"Добавяне на дейност към секция "{$a}"";s:8:"addadmin";s:48:"Добавяне на администратор";s:8:"addblock";s:25:"Добавяне блок";s:10:"addcomment";s:42:"Добавяне на коментар ...";s:12:"addcondition";s:36:"Добавяне на условие";s:20:"addcountertousername";s:131:"Създаване на потребител чрез добавяне на номер към потребителското име";s:10:"addcreator";s:52:"Добавяне на автор на курсове";s:7:"adddots";s:19:"Добавяне...";s:5:"added";s:21:"Добавяне {$a}";s:12:"addedtogroup";s:39:"Добавен към група "{$a}"";s:15:"addedtogroupnot";s:47:"Не е добавен към група "{$a}"";s:23:"addedtogroupnotenrolled";s:96:"Не е добавен към група "{$a}", защото не е записан в курс";s:11:"addfilehere";s:104:"Пуснете файлове тук, за да ги добавите накрая на секцията";s:12:"addfilesdrop";s:167:"Можете да плъзнете и пуснете файлове тук, за да ги качите, или да щракнете, за да ги изберете.";s:10:"addinganew";s:11:"Нов {$a}";s:19:"additionalcustomnav";s:74:"Допълнителна персонализирана навигация";s:6:"addnew";s:26:"Добавяне на {$a}";s:20:"addingdatatoexisting";s:68:"Добавяне на данни към съществуващите";s:15:"additionalnames";s:35:"Допълнителни имена";s:11:"addlinkhere";s:36:"Добавяне връзка тук";s:14:"addnewcategory";s:49:"Добавяне на нова категория";s:12:"addnewcourse";s:37:"Добавяне на нов курс";s:10:"addnewuser";s:49:"Добавяне на нов потребител";s:15:"addnousersrecip";s:138:"Добавяне към списъка с получатели на потребителите, които не са отваряли {$a}";s:11:"addpagehere";s:39:"Добавяне на текст тук";s:11:"addresource";s:34:"Добавяне на ресурс";s:21:"addresourceoractivity";s:56:"Добавяне на дейност или ресурс";s:20:"addresourcetosection";s:61:"Добавяне на ресурс към секция "{$a}"";s:7:"address";s:10:"Адрес";s:11:"addsections";s:34:"Добавяне на секции";s:10:"addstudent";s:34:"Добавяне на ученик";s:14:"addsubcategory";s:46:"Добавяне на подкатегория";s:10:"addteacher";s:34:"Добавяне на учител";s:5:"admin";s:26:"Администратор";s:19:"adminhelpaddnewuser";s:80:"За да се създаде ръчно потребителски профил";s:21:"adminhelpassignadmins";s:128:"Администраторите могат да правят всичко и да отиват навсякъде в сайта";s:23:"adminhelpassigncreators";s:93:"Авторите на курсове могат да създават нови курсове";s:24:"adminhelpassignsiteroles";s:122:"Прилагане на определените роли в сайта към специфични потребители";s:23:"adminhelpassignstudents";s:116:"Отидете в курса и добавете студенти от администраторското меню";s:23:"adminhelpauthentication";s:146:"Може да използвате вътрешни потребителски регистрации или външни бази от данни";s:15:"adminhelpbackup";s:124:"Конфигуриране на автоматичния архив и неговия график на изпълнение";s:22:"adminhelpconfiguration";s:77:"Конфигуриране как сайта работи и изглежда";s:24:"adminhelpconfigvariables";s:140:"Конфигуриране на променливите, които влияят върху основната работа на сайта";s:16:"adminhelpcourses";s:167:"Дефиниране на курсове и категории и добавяне на хора към тях, редактиране на чакащи курсове";s:23:"adminhelpeditorsettings";s:90:"Определяне на базовите настройки за HTML редактора";s:17:"adminhelpedituser";s:131:"Търсене в списъка с потребителски профили и редактиране на всеки от тях";s:20:"adminhelpenvironment";s:151:"Проверете дали вашия сървър отговаря на текущите и бъдещи изискваня за инсталация";s:20:"adminhelpfailurelogs";s:87:"Преглеждане на журналите за неуспешни влизания";s:17:"adminhelplanguage";s:95:"За проверка и редактиране на настоящия езиков пакет";s:13:"adminhelplogs";s:100:"Преглеждане на журнали за всички дейности на този сайт";s:21:"adminhelpmanageblocks";s:106:"Управляване на инсталираните блокове и техните настройки";s:23:"adminhelpmanagedatabase";s:100:"Директен достъп до базата от данни (бъдете внимателни!)";s:22:"adminhelpmanagefilters";s:98:"Избор на текстови филтри и свързаните с тях настройки";s:22:"adminhelpmanagemodules";s:104:"Управляване на инсталираните модули и техните настройки";s:20:"adminhelpmanageroles";s:131:"Създава и дефинира роли, които могат да бъдат задавани на потребителите";s:17:"adminhelpmymoodle";s:85:"Конфигуриране на  My Moodle блокове за потребители";s:16:"adminhelpreports";s:35:"Отчети на ниво сайт";s:18:"adminhelpsitefiles";s:115:"За публикуване на основни файлове или качване на външни архиви";s:21:"adminhelpsitesettings";s:96:"Определете как изглежда началната страница на сайта";s:21:"adminhelpstickyblocks";s:88:"Конфигуриране на прилепени блокове за целия Moodle";s:15:"adminhelpthemes";s:100:"Избиране как да изглежда сайта (цветове, шрифтове и др.)";s:20:"adminhelpuploadusers";s:115:"Импортиране на нови потребителски регистрации от текстов файл";s:14:"admin